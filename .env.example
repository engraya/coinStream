# Coinranking API via RapidAPI
# Get your key at https://rapidapi.com/Coinranking/api/coinranking1
# IMPORTANT: Do NOT prefix with NEXT_PUBLIC_ — this key must stay server-side only
RAPID_API_KEY=your_rapidapi_key_here

# Optional: GNews API key for crypto news feed (free tier: 100 req/day)
# https://gnews.io
GNEWS_API_KEY=your_gnews_api_key_here
